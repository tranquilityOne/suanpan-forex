# 复制为 deploy/.env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 这里的值只用于本地开发，其他环境的密码通过各自的环境变量注入（见 docs/conventions/backend.md §12）。

# PostgreSQL 超级用户 postgres 的密码（只用于初始化和本地维护，程序不用这个账号）
POSTGRES_PASSWORD=

# 业务库和三个数据库账号的密码（见 docs/conventions/database.md §2.2）
SUANPAN_DB=suanpan
SUANPAN_MIGRATOR_PASSWORD=
SUANPAN_APP_PASSWORD=
SUANPAN_PORTAL_PASSWORD=

# Redis（Valkey）
REDIS_PASSWORD=

# RabbitMQ（虚拟主机固定为 suanpan）
RABBITMQ_USER=suanpan
RABBITMQ_PASSWORD=

# 宿主机端口，只绑定 127.0.0.1；与本机已有的服务冲突时修改
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
