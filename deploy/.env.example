# 复制为 deploy/.env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 这里的值只用于本地开发，其他环境的密码通过各自的环境变量注入（见 docs/conventions/backend.md §12）。

# PostgreSQL 超级用户 postgres 的密码（只用于初始化和本地维护，程序不用这个账号）
POSTGRES_PASSWORD=

# 业务库和三个数据库账号的密码（见 docs/conventions/database.md §2.2）
SUANPAN_DB=suanpan
SUANPAN_MIGRATOR_PASSWORD=
SUANPAN_APP_PASSWORD=
SUANPAN_PORTAL_PASSWORD=

# Redis（Valkey）
REDIS_PASSWORD=

# RabbitMQ（虚拟主机固定为 suanpan）
RABBITMQ_USER=suanpan
RABBITMQ_PASSWORD=

# 宿主机端口，只绑定 127.0.0.1；与本机已有的服务冲突时修改
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 以下只在用 apps 配置组启动四个程序时需要（docker compose --profile apps，见 README）
# 加密密钥：32 字节随机数的 Base64（如 openssl rand -base64 32），TOTP 密钥和数据源凭据共用；Crm、Collector 使用
SUANPAN_ENCRYPTION_KEY=
# 初始管理员（Crm 首次启动时创建，见 docs/design/sys.md §3.4）
SUANPAN_SEED_ADMIN_USERNAME=
SUANPAN_SEED_ADMIN_PASSWORD=
# 采集请求 User-Agent 中的联系邮箱（PRD BR-005，采集设计 §11 第 7 项）；Crm、Job、Collector 使用，不填时启动告警、请求不带邮箱
SUANPAN_CONTACT_EMAIL=
# 程序的宿主机端口（容器内都监听 8080）；与 dotnet run 的 5100、5200 分开，可以同时运行
CRM_PORT=8100
PORTAL_PORT=8200
