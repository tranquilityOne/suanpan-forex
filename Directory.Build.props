<Project>

  <!-- 所有项目共用的编译设置，见 docs/conventions/backend.md §3.1 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 四个程序（Web SDK）共用一份本地 user-secrets，见 docs/conventions/backend.md §12 -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'">
    <UserSecretsId>suanpan-forex</UserSecretsId>
  </PropertyGroup>

</Project>
