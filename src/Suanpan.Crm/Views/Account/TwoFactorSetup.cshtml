@model Suanpan.Crm.Models.Account.TwoFactorSetupViewModel
@{
    ViewData["Title"] = "绑定二次验证";
    Layout = Model.IsSignedIn ? "_Layout" : "_LayoutAccount";
}

<div class="card card-md @(Model.IsSignedIn ? "mx-auto" : "")" style="@(Model.IsSignedIn ? "max-width: 32rem" : "")">
    <div class="card-body">
        <h2 class="h2 text-center mb-2">绑定二次验证</h2>
        @if (Model.IsSignedIn)
        {
            <div class="alert alert-warning">重新绑定后，原来验证器里的验证码失效，其他设备上的登录也会失效。</div>
        }
        else
        {
            <p class="text-secondary text-center mb-4">登录后台需要二次验证，请先完成绑定</p>
        }
        <ol class="mb-3 ps-3">
            <li>在手机上安装验证器 App（如 Microsoft Authenticator、Google Authenticator）</li>
            <li>用 App 扫描下面的二维码；无法扫码时，手动输入密钥</li>
            <li>输入 App 中显示的 6 位验证码</li>
        </ol>
        <div class="text-center mb-3">
            <img src="@Model.QrCodeDataUri" alt="二次验证二维码" width="200" height="200" />
            <div class="mt-2"><span class="text-secondary small">密钥：</span><code class="user-select-all">@Model.SecretForDisplay</code></div>
        </div>
        <form asp-action="TwoFactorSetup" method="post" autocomplete="off">
            <input type="hidden" asp-for="ProtectedSecret" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-center fs-2 font-monospace" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" />
                <span asp-validation-for="Code"></span>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">完成绑定</button>
            </div>
        </form>
    </div>
</div>
@if (!Model.IsSignedIn)
{
    <partial name="_CancelSignIn" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
