@model Suanpan.Crm.Models.Account.ChangePasswordViewModel
@using Suanpan.Core.Sys.Rules
@{
    ViewData["Title"] = "修改密码";
    Layout = Model.IsSignedIn ? "_Layout" : "_LayoutAccount";
}

<div class="card card-md @(Model.IsSignedIn ? "mx-auto" : "")" style="@(Model.IsSignedIn ? "max-width: 32rem" : "")">
    <div class="card-body">
        <h2 class="h2 text-center mb-2">修改密码</h2>
        @if (Model.IsSignedIn)
        {
            <p class="text-secondary text-center mb-4">修改后，其他设备上的登录会失效</p>
        }
        else
        {
            <p class="text-secondary text-center mb-4">首次登录或密码已被管理员重置，请先设置新密码</p>
        }
        <form asp-action="ChangePassword" method="post" autocomplete="off">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @if (Model.IsSignedIn)
            {
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label required"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword"></span>
                </div>
            }
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">至少 @PasswordPolicy.MinLength 位，同时包含英文字母和数字，不能与当前密码相同</div>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">保存新密码</button>
            </div>
        </form>
    </div>
</div>
@if (!Model.IsSignedIn)
{
    <partial name="_CancelSignIn" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
