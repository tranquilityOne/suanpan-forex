@{
    ViewData["Title"] = "出错了";
    Layout = "_LayoutAccount";
}

<div class="empty">
    <div class="empty-icon"><i class="ti ti-alert-triangle text-danger" style="font-size: 2.5rem"></i></div>
    <p class="empty-title">处理请求时出错了</p>
    <p class="empty-subtitle text-secondary">请稍后重试；如果问题持续，把下面的请求编号告诉工程师</p>
    <p><code>@ViewData["RequestId"]</code></p>
    <div class="empty-action">
        <a href="/" class="btn btn-primary"><i class="ti ti-home me-1"></i>返回首页</a>
    </div>
</div>
