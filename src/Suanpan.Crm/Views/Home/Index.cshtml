@using System.Security.Claims
@using Suanpan.Shared.Auth
@{
    ViewData["Title"] = "首页";
    var displayName = User.FindFirstValue(SuanpanClaimTypes.RealName) ?? User.Identity?.Name;
}

<div class="page-header mb-3">
    <h2 class="page-title">欢迎，@displayName</h2>
</div>
<div class="card">
    <div class="card-body text-secondary">
        左侧菜单中是你有权限使用的栏目。修改密码、重新绑定二次验证在右上角的用户菜单中。
    </div>
</div>
