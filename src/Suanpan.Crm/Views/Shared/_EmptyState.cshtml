@model EmptyStateModel
@*
    空状态部件（前端约定 §6）：列表没有数据时代替表格显示。
    用法：<partial name="_EmptyState" model='new EmptyStateModel("还没有数据源", "新增数据源", Url.Action("Create"))' />
*@
<div class="empty">
    <div class="empty-icon"><i class="ti ti-@Model.Icon" style="font-size: 2.5rem"></i></div>
    <p class="empty-title">@Model.Message</p>
    @if (Model.ActionText is not null && Model.ActionUrl is not null)
    {
        <div class="empty-action">
            <a href="@Model.ActionUrl" class="btn btn-primary"><i class="ti ti-plus me-1"></i>@Model.ActionText</a>
        </div>
    }
</div>
