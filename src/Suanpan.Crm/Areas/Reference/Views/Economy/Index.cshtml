@model IReadOnlyList<Suanpan.Services.Reference.Economies.Models.EconomyRow>
@{
    ViewData["Title"] = "经济体";
}

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">经济体</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Create" asp-permission="reference:economy:create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增经济体</a>
        </div>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("还没有经济体")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle card-table text-nowrap">
                <thead>
                    <tr><th>编码</th><th>中文名称</th><th>英文名称</th><th>货币</th><th>时区</th><th class="text-end">显示顺序</th><th class="text-end">指标数</th><th>状态</th><th class="w-1"></th></tr>
                </thead>
                <tbody>
                    @foreach (var economy in Model)
                    {
                        <tr>
                            <td><code>@economy.Code</code></td>
                            <td>@economy.Name.Zh</td>
                            <td>@economy.Name.En</td>
                            <td><code>@economy.CurrencyCode</code></td>
                            <td>@economy.TimeZone</td>
                            <td class="text-end font-monospace">@economy.Sort</td>
                            <td class="text-end font-monospace">@economy.IndicatorCount</td>
                            <td><status-badge tone="@(economy.IsEnabled ? BadgeTone.Success : BadgeTone.Neutral)" text="@(economy.IsEnabled ? "启用" : "停用")" /></td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a asp-action="Edit" asp-route-id="@economy.Code" asp-permission="reference:economy:edit" class="btn btn-sm">编辑</a>
                                    @if (economy.IsEnabled)
                                    {
                                        <confirm-form asp-action="SetStatus" asp-route-id="@economy.Code" asp-route-enabled="false" asp-permission="reference:economy:set_status"
                                                      message="@($"停用经济体 {economy.Code}？停用后不能再被新选用，已有的引用不受影响。")" button-text="停用" />
                                    }
                                    else
                                    {
                                        <confirm-form asp-action="SetStatus" asp-route-id="@economy.Code" asp-route-enabled="true" asp-permission="reference:economy:set_status"
                                                      message="@($"启用经济体 {economy.Code}？")" button-text="启用" button-class="btn btn-sm btn-outline-success" />
                                    }
                                    @if (!economy.IsReferenced)
                                    {
                                        <confirm-form asp-action="Delete" asp-route-id="@economy.Code" asp-permission="reference:economy:delete" button-text="删除"
                                                      message="@($"删除经济体 {economy.Code}？删除后不能恢复。")" />
                                    }
                                    else
                                    {
                                        <button type="button" asp-permission="reference:economy:delete" class="btn btn-sm" disabled title="有指标或数据源属于该经济体，不能删除，可以停用">删除</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
