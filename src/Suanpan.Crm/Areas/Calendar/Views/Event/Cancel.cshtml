@model EventReasonViewModel
@{
    ViewData["Title"] = "取消事件";
    var e = Model.Detail!.Event;
}

<div class="page-header mb-3">
    <h2 class="page-title">取消事件</h2>
</div>

<div class="card" style="max-width: 40rem">
    <div class="card-body border-bottom">
        <partial name="_EventSummary" model="Model.Detail" />
    </div>
    <form asp-action="Cancel" asp-route-id="@e.Id" method="post" class="card-body"
          data-confirm="@($"取消 {e.IndicatorCode} {e.ReferencePeriod}？取消后事件不再参与采集、盯盘等自动处理，也不能再改回其他状态。")"
          data-confirm-button="取消事件">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="RowVersion" />
        <div class="mb-3">
            <label asp-for="Reason" class="form-label required">取消原因</label>
            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="如：官方宣布本期停发"></textarea>
            <div class="form-text">写进事件的变更历史和操作日志</div>
            <span asp-validation-for="Reason"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">取消事件</button>
            <a asp-action="Detail" asp-route-id="@e.Id" class="btn">返回</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
