@model EventScheduleView
@* 排期：按操作者时区显示，下面注明官方的当地时间和时区；仅日期、待定的不显示时刻 *@
@if (Model.Precision == TimePrecision.Minute)
{
    <utc-time value="@Model.ScheduledAt" />
    <div class="text-secondary small">当地 @Model.ScheduledLocal?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)（@Model.TimeZone）</div>
}
else
{
    <span>@(Model.ScheduledLocal?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "日期待定")</span>
    <status-badge tone="Neutral" text="@CalendarDisplayNames.Get(Model.Precision)" />
    <div class="text-secondary small">当地日期（@Model.TimeZone）</div>
}
