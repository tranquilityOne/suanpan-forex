@model ForecastListViewModel
@{
    ViewData["Title"] = "预期值录入";
}

<div class="page-header mb-3">
    <h2 class="page-title">预期值录入</h2>
    <div class="text-secondary">未来 7 天内未公布、还没有预期值的事件，按排期时间排列，时间按你的时区显示。保存后预期值被锁定，并自动定位到下一条；公布后只有管理员能在事件详情中更正。</div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a asp-action="Index" class="nav-link @(Model.All ? null : "active")">高重要性</a>
    </li>
    <li class="nav-item">
        <a asp-action="Index" asp-route-all="true" class="nav-link @(Model.All ? "active" : null)">全部重要性</a>
    </li>
</ul>

<partial name="_ForecastNoteOptions" model="Model.NoteOptions" />

<div class="card">
    @if (Model.Result.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("未来 7 天没有待录入预期值的事件")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle card-table">
                <thead>
                    <tr>
                        <th>时间</th><th>经济体</th><th>指标</th><th>参考期</th><th>重要性</th><th class="text-end">前值</th><th>预期值</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Result.Items)
                    {
                        <partial name="_Row" model="ForecastRowViewModel.Pending(row)" />
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Result" />
    }
</div>
