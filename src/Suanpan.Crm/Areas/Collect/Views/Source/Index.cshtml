@model IReadOnlyList<Suanpan.Services.Collect.Sources.Models.DataSourceRow>
@using Suanpan.Core.Collect.Enums
@{
    ViewData["Title"] = "数据源";
}

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">数据源</h2>
            <div class="text-secondary">新建的数据源为停用状态；合规类别为"待确认"或 robots.txt 为"不允许"时不能启用。</div>
        </div>
        <div class="col-auto">
            <a asp-action="Create" asp-permission="collect:source:create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增数据源</a>
        </div>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("还没有数据源")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle card-table text-nowrap">
                <thead>
                    <tr><th>名称</th><th>所属机构</th><th>经济体</th><th>类型</th><th class="text-end">频率上限</th><th>合规类别</th><th>robots.txt</th><th>凭据</th><th>状态</th><th class="text-end">任务数</th><th class="w-1"></th></tr>
                </thead>
                <tbody>
                    @foreach (var source in Model)
                    {
                        <tr>
                            <td>@source.Name</td>
                            <td>@source.Agency</td>
                            <td>@if (source.EconomyCode is not null) { <code>@source.EconomyCode</code> }</td>
                            <td>@CollectDisplayNames.Get(source.Type)</td>
                            <td class="text-end"><span class="font-monospace">@source.RateLimit</span> @CollectDisplayNames.Get(source.RateLimitUnit)</td>
                            <td>
                                @if (source.ComplianceClass == ComplianceClass.Pending)
                                {
                                    <status-badge tone="Attention" text="@CollectDisplayNames.Get(source.ComplianceClass)" />
                                }
                                else
                                {
                                    @CollectDisplayNames.Get(source.ComplianceClass)
                                }
                            </td>
                            <td>
                                @if (source.RobotsResult == RobotsResult.Disallowed)
                                {
                                    <status-badge tone="Failure" text="@CollectDisplayNames.Get(source.RobotsResult)" />
                                }
                                else
                                {
                                    @CollectDisplayNames.Get(source.RobotsResult)
                                }
                            </td>
                            <td class="text-secondary">@(source.HasCredential ? "已设置" : source.CredentialRequired ? "未设置" : "不需要")</td>
                            <td><status-badge tone="@(source.IsEnabled ? BadgeTone.Success : BadgeTone.Neutral)" text="@(source.IsEnabled ? "启用" : "停用")" /></td>
                            <td class="text-end">
                                @if (source.TaskCount > 0)
                                {
                                    <a asp-controller="Task" asp-action="Index" asp-route-SourceId="@source.Id" class="font-monospace">@source.TaskCount</a>
                                }
                                else
                                {
                                    <span class="font-monospace text-secondary">0</span>
                                }
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a asp-action="Detail" asp-route-id="@source.Id" asp-permission="collect:source:detail" class="btn btn-sm">详情</a>
                                    <a asp-action="Edit" asp-route-id="@source.Id" asp-permission="collect:source:edit" class="btn btn-sm">编辑</a>
                                    @if (source.IsEnabled)
                                    {
                                        <confirm-form asp-action="SetStatus" asp-route-id="@source.Id" asp-route-enabled="false" asp-permission="collect:source:set_status"
                                                      message="@($"停用数据源 {source.Name}？它下面的采集任务将停止执行。")" button-text="停用" />
                                    }
                                    else
                                    {
                                        <confirm-form asp-action="SetStatus" asp-route-id="@source.Id" asp-route-enabled="true" asp-permission="collect:source:set_status"
                                                      message="@($"启用数据源 {source.Name}？启用后它下面的采集任务开始执行。")" button-text="启用" button-class="btn btn-sm btn-outline-success" />
                                    }
                                    <confirm-form asp-action="Delete" asp-route-id="@source.Id" asp-permission="collect:source:delete" button-text="删除"
                                                  message="@($"删除数据源 {source.Name}？删除后不能恢复；被采集任务引用的数据源不能删除，可以停用。")" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
