@model Suanpan.Services.Collect.Runs.Models.CollectRunDetail
@using Suanpan.Core.Collect.Enums
@*
    运行详情的内容区块（采集设计 §8.1）。排队、运行中时每 2 秒用 HTMX 取一次本区块替换自己，结束后不再刷新
    （前端约定 §4.1"手动触发采集"）；标签页不可见时暂停。错误信息按纯文本输出（硬性规则 10）。
    一路盯盘的请求记录默认折叠内容未变化的请求，展开后自动刷新也保持展开。
*@
@{
    var run = Model.Run;
    var refreshing = !CollectRunStatusRule.IsFinished(run.Status);
    var watchSession = CollectRunStatusRule.IsWatchSession(run);
    var all = ViewData[Suanpan.Crm.Areas.Collect.Controllers.RunController.AllAttemptsKey] is true;
    var attempts = CollectAttemptsView.Visible(run.Attempts, collapse: watchSession && !all);
    var hidden = run.Attempts.Count - attempts.Count;
    var columns = watchSession ? 7 : 6;
    var previousNo = 0;
}
@* 值为 null 的属性不输出：结束后的区块没有 hx-* 属性，替换上去就不再刷新 *@
<div id="run-detail"
     hx-get="@(refreshing ? Url.Action("Detail", new { id = run.Id, all = all ? true : (bool?)null }) : null)"
     hx-trigger="@(refreshing ? "every 2s [!document.hidden]" : null)"
     hx-swap="@(refreshing ? "outerHTML" : null)">
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">
                        概况
                        @if (refreshing)
                        {
                            <span class="text-secondary small fw-normal ms-2"><span class="spinner-border spinner-border-sm me-1"></span>自动刷新中</span>
                        }
                    </h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">状态</dt>
                        <dd class="col-sm-8"><status-badge value="@run.Status" /></dd>
                        <dt class="col-sm-4">任务</dt>
                        <dd class="col-sm-8">@Model.TaskName</dd>
                        <dt class="col-sm-4">数据源</dt>
                        <dd class="col-sm-8">@(Model.SourceName ?? "（已删除）")</dd>
                        <dt class="col-sm-4">目标数据类型</dt>
                        <dd class="col-sm-8">@CollectDisplayNames.Get(Model.TargetType)</dd>
                        <dt class="col-sm-4">触发方式</dt>
                        <dd class="col-sm-8">
                            @CollectDisplayNames.Get(run.Trigger)
                            @if (run.TriggeredBy is not null)
                            {
                                <span class="text-secondary">（@run.TriggeredBy）</span>
                            }
                        </dd>
                        @if (run.ScheduledFor is not null)
                        {
                            <dt class="col-sm-4">定时时间点</dt>
                            <dd class="col-sm-8"><utc-time value="@run.ScheduledFor" /></dd>
                        }
                        <dt class="col-sm-4">触发时间</dt>
                        <dd class="col-sm-8"><utc-time value="@run.QueuedAt" format="yyyy-MM-dd HH:mm:ss" /></dd>
                        <dt class="col-sm-4">开始时间</dt>
                        <dd class="col-sm-8"><utc-time value="@run.StartedAt" format="yyyy-MM-dd HH:mm:ss" /></dd>
                        <dt class="col-sm-4">结束时间</dt>
                        <dd class="col-sm-8"><utc-time value="@run.EndedAt" format="yyyy-MM-dd HH:mm:ss" /></dd>
                        <dt class="col-sm-4">耗时</dt>
                        <dd class="col-sm-8 font-monospace">@(CollectRunDurations.Format(run.StartedAt, run.EndedAt) ?? "-")</dd>
                        <dt class="col-sm-4">请求次数</dt>
                        <dd class="col-sm-8 font-monospace">@run.AttemptCount</dd>
                        @if (run.NextAttemptAt is not null && run.Status == CollectRunStatus.Running)
                        {
                            <dt class="col-sm-4">下次重试</dt>
                            <dd class="col-sm-8"><utc-time value="@run.NextAttemptAt" format="yyyy-MM-dd HH:mm:ss" /></dd>
                        }
                        <dt class="col-sm-4">新增 / 更新 / 跳过</dt>
                        <dd class="col-sm-8 font-monospace">@run.InsertedCount / @run.UpdatedCount / @run.SkippedCount</dd>
                        <dt class="col-sm-4">因锁定跳过</dt>
                        <dd class="col-sm-8 font-monospace">@run.LockedCount</dd>
                        @if (run.Reparse is { } reparse)
                        {
                            <dt class="col-sm-4">解析器</dt>
                            <dd class="col-sm-8"><code>@reparse.ParserKey</code></dd>
                            <dt class="col-sm-4">快照数</dt>
                            <dd class="col-sm-8 font-monospace">@reparse.SnapshotIds.Count</dd>
                        }
                        @if (run.TraceId is not null)
                        {
                            <dt class="col-sm-4">追踪 ID</dt>
                            <dd class="col-sm-8"><code class="small">@run.TraceId</code></dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            @if (run.ErrorCode is not null || run.ErrorMessage is not null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="card-title">错误</h3>
                        @if (run.ErrorCode is not null)
                        {
                            <div class="mb-2"><code>@run.ErrorCode</code></div>
                        }
                        @if (run.ErrorMessage is not null)
                        {
                            <pre class="mb-0" style="white-space: pre-wrap">@run.ErrorMessage</pre>
                        }
                    </div>
                </div>
            }
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">请求记录</h3>
                    @if (watchSession && all)
                    {
                        <div class="card-actions"><a href="@Url.Action("Detail", new { id = run.Id })" class="btn btn-sm">只看有变化或失败的</a></div>
                    }
                    else if (hidden > 0)
                    {
                        <div class="card-actions">
                            <span class="text-secondary small me-2">已折叠 @hidden 条内容未变化的请求</span>
                            <a href="@Url.Action("Detail", new { id = run.Id, all = true })" class="btn btn-sm">展开全部</a>
                        </div>
                    }
                </div>
                @if (run.Trigger == CollectRunTrigger.Reparse)
                {
                    <div class="card-body text-secondary">重新解析不请求数据源，处理的是已保存的快照</div>
                }
                else if (run.Attempts.Count == 0)
                {
                    <div class="card-body text-secondary">还没有发出请求</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle card-table">
                            <thead>
                                <tr>
                                    <th class="text-end">序号</th><th>开始时间</th><th class="text-end">耗时（毫秒）</th><th class="text-end">HTTP 状态码</th>
                                    <th class="text-end">延后（秒）</th>
                                    @if (watchSession)
                                    {
                                        <th>内容</th>
                                    }
                                    <th>错误</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attempt in attempts)
                                {
                                    if (attempt.No - previousNo > 1)
                                    {
                                        <tr><td colspan="@columns" class="text-center text-secondary small">… 折叠了 @(attempt.No - previousNo - 1) 条 …</td></tr>
                                    }
                                    previousNo = attempt.No;
                                    <tr>
                                        <td class="text-end font-monospace">@attempt.No</td>
                                        <td class="text-nowrap"><utc-time value="@attempt.StartedAt" format="yyyy-MM-dd HH:mm:ss" /></td>
                                        <td class="text-end font-monospace">@attempt.DurationMs</td>
                                        <td class="text-end font-monospace">@(attempt.HttpStatus?.ToString() ?? "-")</td>
                                        <td class="text-end font-monospace">@(attempt.DeferredMs > 0 ? (attempt.DeferredMs / 1000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "-")</td>
                                        @if (watchSession)
                                        {
                                            <td>@(attempt.Changed == true ? "有变化" : "")</td>
                                        }
                                        <td class="text-break">@attempt.Error</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.Snapshots.Count > 0)
            {
                <div class="card mt-3">
                    <div class="card-header"><h3 class="card-title">快照</h3></div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle card-table">
                            <thead>
                                <tr><th class="text-end">请求</th><th class="text-end">序号</th><th>地址</th><th class="text-end">状态码</th><th class="text-end">大小</th><th>未变化</th><th>有效</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var snapshot in Model.Snapshots)
                                {
                                    <tr>
                                        <td class="text-end font-monospace">@snapshot.Attempt</td>
                                        <td class="text-end font-monospace">@(snapshot.Seq + 1)</td>
                                        <td class="text-break">
                                            @* 编辑、只读没有快照的查看权限（采集设计 §8.3），只显示地址 *@
                                            <a asp-controller="Snapshot" asp-action="Detail" asp-route-id="@snapshot.Id" asp-permission="collect:snapshot:detail">#@snapshot.Id</a>
                                            @snapshot.Url
                                        </td>
                                        <td class="text-end font-monospace">@snapshot.HttpStatus</td>
                                        <td class="text-end font-monospace">@SnapshotContentView.Size(snapshot.Size)</td>
                                        <td>@(snapshot.Unchanged ? "是" : "")</td>
                                        <td>@(snapshot.IsValid ? "有效" : "无效")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
