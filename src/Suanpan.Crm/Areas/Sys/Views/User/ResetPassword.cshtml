@model ResetPasswordViewModel
@using Suanpan.Core.Sys.Rules
@{
    ViewData["Title"] = "重置密码";
}

<div class="page-header mb-3">
    <h2 class="page-title">重置密码：<code>@Model.Username</code></h2>
</div>

<div class="card" style="max-width: 40rem">
    <form asp-action="ResetPassword" method="post" class="card-body" autocomplete="off">
        <input type="hidden" asp-for="Id" />
        <div class="alert alert-warning">重置后该账号已登录的会话立即失效；用临时密码登录后必须先修改密码。</div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label required"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <div class="form-text">至少 @PasswordPolicy.MinLength 位，同时包含英文字母和数字；线下告知本人</div>
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label required"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">重置密码</button>
            <a asp-action="Index" class="btn">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
