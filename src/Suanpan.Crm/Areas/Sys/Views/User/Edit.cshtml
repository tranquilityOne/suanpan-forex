@model UserEditViewModel
@{
    ViewData["Title"] = "编辑账号";
}

<div class="page-header mb-3">
    <h2 class="page-title">编辑账号</h2>
</div>

<div class="card" style="max-width: 40rem">
    <form asp-action="Edit" method="post" class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label class="form-label">登录名</label>
            <div class="form-control-plaintext"><code>@Model.Username</code></div>
        </div>
        <div class="mb-3">
            <label asp-for="RealName" class="form-label required"></label>
            <input asp-for="RealName" class="form-control" />
            <span asp-validation-for="RealName"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </div>
        <partial name="_RoleChecks" model="(Model.RoleOptions, (IReadOnlyCollection<long>)Model.RoleIds)" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">保存</button>
            <a asp-action="Index" class="btn">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
