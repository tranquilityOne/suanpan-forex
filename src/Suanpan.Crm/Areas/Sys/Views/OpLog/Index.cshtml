@model OpLogListViewModel
@using Suanpan.Services.Sys.Logging
@{
    ViewData["Title"] = "操作日志";
    var filter = Model.Filter;
}

<div class="page-header mb-3">
    <h2 class="page-title">操作日志</h2>
    <div class="text-secondary">后台的写操作和导出都有记录，只能查询和导出，不能修改或删除。</div>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">操作人</label>
        <input name="Username" value="@filter.Username" class="form-control form-control-sm" placeholder="登录名" />
    </div>
    <div class="col-auto">
        <label class="form-label">模块</label>
        <select name="Module" class="form-select form-select-sm">
            <option value="">全部</option>
            @foreach (var group in Model.ActionsByModule)
            {
                <option value="@group.Key" selected="@(filter.Module == group.Key)">@group.Key</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">动作</label>
        <select name="ActionName" class="form-select form-select-sm">
            <option value="">全部</option>
            @foreach (var group in Model.ActionsByModule)
            {
                <optgroup label="@group.Key">
                    @foreach (var action in group)
                    {
                        <option value="@action" selected="@(filter.ActionName == action)">@action</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">结果</label>
        <select name="IsSuccess" class="form-select form-select-sm">
            <option value="">全部</option>
            <option value="true" selected="@(filter.IsSuccess == true)">成功</option>
            <option value="false" selected="@(filter.IsSuccess == false)">失败</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">日期</label>
        <div class="d-flex align-items-center gap-1">
            <input type="date" name="From" value="@filter.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <span>至</span>
            <input type="date" name="To" value="@filter.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">查询</button>
        <a asp-action="Index" class="btn btn-sm">重置</a>
        <button type="submit" formaction="@Url.Action("Export")" asp-permission="sys:op_log:export" class="btn btn-sm"><i class="ti ti-download me-1"></i>导出 CSV</button>
    </div>
</form>

@if (Model.Result.Total > LogExport.MaxRows)
{
    <div class="alert alert-warning">符合条件的有 @Model.Result.Total 条，单次最多导出最新的 @LogExport.MaxRows 条，请缩小时间范围后分批导出。</div>
}

<div class="card">
    @if (Model.Result.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("没有符合条件的操作日志")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle card-table text-nowrap">
                <thead>
                    <tr><th>时间</th><th>操作人</th><th>模块</th><th>动作</th><th>结果</th><th>耗时</th><th>IP</th><th class="w-1"></th></tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Result.Items)
                    {
                        var detailId = $"op-log-{log.Id}";
                        <tr>
                            <td><utc-time value="@log.CreatedAt" format="yyyy-MM-dd HH:mm:ss" /></td>
                            <td><code class="small">@log.Username</code></td>
                            <td>@log.Module</td>
                            <td>@log.Action</td>
                            <td>
                                <status-badge tone="@(log.IsSuccess ? BadgeTone.Success : BadgeTone.Failure)" text="@(log.IsSuccess ? "成功" : "失败")" />
                            </td>
                            <td class="text-secondary">@log.DurationMs ms</td>
                            <td class="font-monospace small">@log.Ip</td>
                            <td>
                                <button type="button" class="btn btn-sm" data-bs-toggle="collapse" data-bs-target="#@detailId"
                                        aria-expanded="false" aria-controls="@detailId">详情</button>
                            </td>
                        </tr>
                        <tr class="collapse" id="@detailId">
                            <td colspan="8" class="bg-body-tertiary text-wrap">
                                <dl class="row mb-0 small">
                                    <dt class="col-2">请求</dt>
                                    <dd class="col-10 font-monospace text-break">@log.HttpMethod @log.RequestUrl</dd>
                                    <dt class="col-2">权限码</dt>
                                    <dd class="col-10 font-monospace">@log.PermCode</dd>
                                    <dt class="col-2">当时的角色</dt>
                                    <dd class="col-10">@log.Roles</dd>
                                    <dt class="col-2">请求参数</dt>
                                    <dd class="col-10"><pre class="mb-0 text-wrap text-break">@log.RequestParams</pre></dd>
                                    @if (!string.IsNullOrEmpty(log.Reason))
                                    {
                                        <dt class="col-2">原因</dt>
                                        <dd class="col-10">@log.Reason</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(log.ErrorMsg))
                                    {
                                        <dt class="col-2">失败原因</dt>
                                        <dd class="col-10 text-danger">@log.ErrorMsg</dd>
                                    }
                                    <dt class="col-2">User-Agent</dt>
                                    <dd class="col-10 text-break">@log.UserAgent</dd>
                                    <dt class="col-2">TraceId</dt>
                                    <dd class="col-10 font-monospace">@log.TraceId</dd>
                                </dl>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Result" />
    }
</div>
