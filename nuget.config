<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- 只使用 nuget.org，不继承本机配置的其他包源，见 docs/conventions/backend.md §3.1 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
