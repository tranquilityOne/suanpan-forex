<Project>

  <!-- 第三方包版本统一写在这里，各项目的 PackageReference 不写 Version。
       程序项目（Collector、Job、Crm、Portal）不直接引用第三方包，见 docs/conventions/backend.md §2、§3.1 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- 数据访问 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- 基础设施 -->
  <ItemGroup>
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Hangfire.Core 传递引用的 Newtonsoft.Json 11.0.1 有已知漏洞（NU1903），显式提升；项目代码不直接使用 -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Hangfire.PostgreSql 只要求 Npgsql 6.0.11 以上；固定为 EF Core 提供程序使用的版本，各项目一致 -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
  </ItemGroup>

  <!-- 业务服务 -->
  <ItemGroup>
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
